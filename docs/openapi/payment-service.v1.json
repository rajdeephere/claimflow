{
  "components" : {
    "parameters" : {
      "CorrelationId" : {
        "description" : "Optional. Traces the request across services and Kafka; generated if absent and always returned in the response header and error bodies.",
        "in" : "header",
        "name" : "X-Correlation-ID",
        "required" : false,
        "schema" : {
          "example" : "7f92a1c2-8e32-4e12-b7d2-91a3f8c4d111",
          "type" : "string"
        }
      }
    },
    "schemas" : {
      "ApiError" : {
        "properties" : {
          "correlationId" : {
            "type" : "string"
          },
          "error" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          },
          "path" : {
            "type" : "string"
          },
          "status" : {
            "format" : "int32",
            "type" : "integer"
          },
          "timestamp" : {
            "format" : "date-time",
            "type" : "string"
          },
          "violations" : {
            "items" : {
              "$ref" : "#/components/schemas/FieldViolation"
            },
            "type" : "array"
          }
        },
        "type" : "object"
      },
      "FieldViolation" : {
        "properties" : {
          "field" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "PaymentResponse" : {
        "properties" : {
          "amount" : {
            "type" : "number"
          },
          "attempts" : {
            "format" : "int32",
            "type" : "integer"
          },
          "claimId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "claimNumber" : {
            "type" : "string"
          },
          "completedAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "failureReason" : {
            "type" : "string"
          },
          "gatewayReference" : {
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "settlement" : {
            "$ref" : "#/components/schemas/SettlementView"
          },
          "status" : {
            "enum" : [ "INITIATED", "COMPLETED", "FAILED" ],
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "SettlementView" : {
        "properties" : {
          "approvedAmount" : {
            "type" : "number"
          },
          "cappedAtLimit" : {
            "type" : "boolean"
          },
          "coverageLimit" : {
            "type" : "number"
          },
          "deductible" : {
            "type" : "number"
          },
          "payableAmount" : {
            "type" : "number"
          }
        },
        "type" : "object"
      }
    }
  },
  "info" : {
    "description" : "Settlements and payments (BillingCenter-like). Read-only: payments are created from ClaimApproved events.\n\nAPI version **v1** (contract 1.0.0). Breaking changes get a new `/api/v2`; additions keep v1 and bump the minor version.",
    "license" : {
      "name" : "Learning project, not for production use"
    },
    "title" : "ClaimFlow Payment API",
    "version" : "1.0.0"
  },
  "openapi" : "3.0.1",
  "paths" : {
    "/api/v1/payments" : {
      "get" : {
        "operationId" : "forClaim",
        "parameters" : [ {
          "in" : "query",
          "name" : "claimId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "$ref" : "#/components/parameters/CorrelationId"
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PaymentResponse"
                }
              }
            },
            "description" : "OK"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Invalid request: malformed body, bad parameter, or failed validation (see `violations`)"
          },
          "404" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "The resource in the URL does not exist"
          },
          "500" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Unexpected error (details are logged, never returned)"
          }
        },
        "summary" : "The payment of a claim (at most one per claim)",
        "tags" : [ "Payments" ]
      }
    },
    "/api/v1/payments/{paymentId}" : {
      "get" : {
        "operationId" : "get",
        "parameters" : [ {
          "in" : "path",
          "name" : "paymentId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "$ref" : "#/components/parameters/CorrelationId"
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PaymentResponse"
                }
              }
            },
            "description" : "OK"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Invalid request: malformed body, bad parameter, or failed validation (see `violations`)"
          },
          "404" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "The resource in the URL does not exist"
          },
          "500" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Unexpected error (details are logged, never returned)"
          }
        },
        "summary" : "Get a payment with its settlement breakdown",
        "tags" : [ "Payments" ]
      }
    }
  },
  "servers" : [ {
    "description" : "API gateway (local)",
    "url" : "http://localhost:8000"
  } ]
}
