{
  "components" : {
    "parameters" : {
      "CorrelationId" : {
        "description" : "Optional. Traces the request across services and Kafka; generated if absent and always returned in the response header and error bodies.",
        "in" : "header",
        "name" : "X-Correlation-ID",
        "required" : false,
        "schema" : {
          "example" : "7f92a1c2-8e32-4e12-b7d2-91a3f8c4d111",
          "type" : "string"
        }
      }
    },
    "schemas" : {
      "AdjusterResponse" : {
        "properties" : {
          "active" : {
            "type" : "boolean"
          },
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "ApiError" : {
        "properties" : {
          "correlationId" : {
            "type" : "string"
          },
          "error" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          },
          "path" : {
            "type" : "string"
          },
          "status" : {
            "format" : "int32",
            "type" : "integer"
          },
          "timestamp" : {
            "format" : "date-time",
            "type" : "string"
          },
          "violations" : {
            "items" : {
              "$ref" : "#/components/schemas/FieldViolation"
            },
            "type" : "array"
          }
        },
        "type" : "object"
      },
      "AssignAdjusterRequest" : {
        "properties" : {
          "adjusterId" : {
            "format" : "uuid",
            "type" : "string"
          }
        },
        "required" : [ "adjusterId" ],
        "type" : "object"
      },
      "ClaimResponse" : {
        "properties" : {
          "adjusterId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "allowedNextStatuses" : {
            "items" : {
              "enum" : [ "SUBMITTED", "UNDER_REVIEW", "APPROVED", "REJECTED", "SETTLEMENT_PENDING", "PAYMENT_INITIATED", "SETTLED", "CLOSED" ],
              "type" : "string"
            },
            "type" : "array",
            "uniqueItems" : true
          },
          "approvedAmount" : {
            "type" : "number"
          },
          "claimNumber" : {
            "type" : "string"
          },
          "claimedAmount" : {
            "type" : "number"
          },
          "coverageLimit" : {
            "type" : "number"
          },
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "deductible" : {
            "type" : "number"
          },
          "description" : {
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "incidentDate" : {
            "format" : "date",
            "type" : "string"
          },
          "lossType" : {
            "enum" : [ "COLLISION", "THEFT", "THIRD_PARTY_LIABILITY", "FIRE", "FLOOD", "HOSPITALIZATION" ],
            "type" : "string"
          },
          "policyId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "rejectionReason" : {
            "type" : "string"
          },
          "reportedAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "status" : {
            "enum" : [ "SUBMITTED", "UNDER_REVIEW", "APPROVED", "REJECTED", "SETTLEMENT_PENDING", "PAYMENT_INITIATED", "SETTLED", "CLOSED" ],
            "type" : "string"
          },
          "updatedAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "version" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "type" : "object"
      },
      "CreateAdjusterRequest" : {
        "properties" : {
          "email" : {
            "maxLength" : 255,
            "minLength" : 0,
            "type" : "string"
          },
          "name" : {
            "maxLength" : 150,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "email", "name" ],
        "type" : "object"
      },
      "FieldViolation" : {
        "properties" : {
          "field" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "FnolRequest" : {
        "properties" : {
          "claimedAmount" : {
            "exclusiveMinimum" : false,
            "minimum" : 0.01,
            "type" : "number"
          },
          "description" : {
            "maxLength" : 2000,
            "minLength" : 0,
            "type" : "string"
          },
          "incidentDate" : {
            "format" : "date",
            "type" : "string"
          },
          "lossType" : {
            "enum" : [ "COLLISION", "THEFT", "THIRD_PARTY_LIABILITY", "FIRE", "FLOOD", "HOSPITALIZATION" ],
            "type" : "string"
          },
          "policyId" : {
            "format" : "uuid",
            "type" : "string"
          }
        },
        "required" : [ "claimedAmount", "description", "incidentDate", "lossType", "policyId" ],
        "type" : "object"
      },
      "HistoryResponse" : {
        "properties" : {
          "correlationId" : {
            "type" : "string"
          },
          "details" : {
            "type" : "string"
          },
          "eventType" : {
            "enum" : [ "CLAIM_CREATED", "CLAIM_VALIDATED", "CLAIM_REJECTED", "ADJUSTER_ASSIGNED", "CLAIM_APPROVED", "SETTLEMENT_REQUESTED", "PAYMENT_INITIATED", "PAYMENT_COMPLETED", "PAYMENT_FAILED", "CLAIM_CLOSED" ],
            "type" : "string"
          },
          "newStatus" : {
            "enum" : [ "SUBMITTED", "UNDER_REVIEW", "APPROVED", "REJECTED", "SETTLEMENT_PENDING", "PAYMENT_INITIATED", "SETTLED", "CLOSED" ],
            "type" : "string"
          },
          "oldStatus" : {
            "enum" : [ "SUBMITTED", "UNDER_REVIEW", "APPROVED", "REJECTED", "SETTLEMENT_PENDING", "PAYMENT_INITIATED", "SETTLED", "CLOSED" ],
            "type" : "string"
          },
          "performedBy" : {
            "type" : "string"
          },
          "timestamp" : {
            "format" : "date-time",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "PageResponseClaimResponse" : {
        "properties" : {
          "content" : {
            "items" : {
              "$ref" : "#/components/schemas/ClaimResponse"
            },
            "type" : "array"
          },
          "page" : {
            "format" : "int32",
            "type" : "integer"
          },
          "size" : {
            "format" : "int32",
            "type" : "integer"
          },
          "totalElements" : {
            "format" : "int64",
            "type" : "integer"
          },
          "totalPages" : {
            "format" : "int32",
            "type" : "integer"
          }
        },
        "type" : "object"
      },
      "UpdateStatusRequest" : {
        "properties" : {
          "approvedAmount" : {
            "exclusiveMinimum" : false,
            "minimum" : 0.01,
            "type" : "number"
          },
          "reason" : {
            "maxLength" : 500,
            "minLength" : 0,
            "type" : "string"
          },
          "targetStatus" : {
            "enum" : [ "SUBMITTED", "UNDER_REVIEW", "APPROVED", "REJECTED", "SETTLEMENT_PENDING", "PAYMENT_INITIATED", "SETTLED", "CLOSED" ],
            "type" : "string"
          }
        },
        "required" : [ "targetStatus" ],
        "type" : "object"
      }
    }
  },
  "info" : {
    "description" : "First Notice of Loss, the claim lifecycle, adjusters and the audit trail (ClaimCenter-like). Supports Idempotency-Key on FNOL and ETag/If-Match on changes.\n\nAPI version **v1** (contract 1.0.0). Breaking changes get a new `/api/v2`; additions keep v1 and bump the minor version.",
    "license" : {
      "name" : "Learning project, not for production use"
    },
    "title" : "ClaimFlow Claim API",
    "version" : "1.0.0"
  },
