{
  "components" : {
    "parameters" : {
      "CorrelationId" : {
        "description" : "Optional. Traces the request across services and Kafka; generated if absent and always returned in the response header and error bodies.",
        "in" : "header",
        "name" : "X-Correlation-ID",
        "required" : false,
        "schema" : {
          "example" : "7f92a1c2-8e32-4e12-b7d2-91a3f8c4d111",
          "type" : "string"
        }
      }
    },
    "schemas" : {
      "ApiError" : {
        "properties" : {
          "correlationId" : {
            "type" : "string"
          },
          "error" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          },
          "path" : {
            "type" : "string"
          },
          "status" : {
            "format" : "int32",
            "type" : "integer"
          },
          "timestamp" : {
            "format" : "date-time",
            "type" : "string"
          },
          "violations" : {
            "items" : {
              "$ref" : "#/components/schemas/FieldViolation"
            },
            "type" : "array"
          }
        },
        "type" : "object"
      },
      "CoverageCheckResponse" : {
        "properties" : {
          "coverageType" : {
            "enum" : [ "COLLISION", "THEFT", "THIRD_PARTY_LIABILITY", "FIRE", "FLOOD", "HOSPITALIZATION" ],
            "type" : "string"
          },
          "covered" : {
            "type" : "boolean"
          },
          "deductible" : {
            "type" : "number"
          },
          "incidentDate" : {
            "format" : "date",
            "type" : "string"
          },
          "limitAmount" : {
            "type" : "number"
          },
          "policyId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "policyNumber" : {
            "type" : "string"
          },
          "reason" : {
            "enum" : [ "COVERED", "POLICY_CANCELLED", "OUTSIDE_POLICY_PERIOD", "COVERAGE_NOT_ON_POLICY" ],
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "CoverageRequest" : {
        "properties" : {
          "coverageType" : {
            "enum" : [ "COLLISION", "THEFT", "THIRD_PARTY_LIABILITY", "FIRE", "FLOOD", "HOSPITALIZATION" ],
            "type" : "string"
          },
          "deductible" : {
            "exclusiveMinimum" : false,
            "minimum" : 0.0,
            "type" : "number"
          },
          "limitAmount" : {
            "exclusiveMinimum" : false,
            "minimum" : 0.01,
            "type" : "number"
          }
        },
        "required" : [ "coverageType", "deductible", "limitAmount" ],
        "type" : "object"
      },
      "CoverageResponse" : {
        "properties" : {
          "coverageType" : {
            "enum" : [ "COLLISION", "THEFT", "THIRD_PARTY_LIABILITY", "FIRE", "FLOOD", "HOSPITALIZATION" ],
            "type" : "string"
          },
          "deductible" : {
            "type" : "number"
          },
          "limitAmount" : {
            "type" : "number"
          }
        },
        "type" : "object"
      },
      "CreateCustomerRequest" : {
        "properties" : {
          "dateOfBirth" : {
            "format" : "date",
            "type" : "string"
          },
          "email" : {
            "maxLength" : 255,
            "minLength" : 0,
            "type" : "string"
          },
          "firstName" : {
            "maxLength" : 100,
            "minLength" : 0,
            "type" : "string"
          },
          "lastName" : {
            "maxLength" : 100,
            "minLength" : 0,
            "type" : "string"
          },
          "phone" : {
            "pattern" : "^\\+?[0-9]{10,15}$",
            "type" : "string"
          }
        },
        "required" : [ "dateOfBirth", "email", "firstName", "lastName" ],
        "type" : "object"
      },
      "CreatePolicyRequest" : {
        "properties" : {
          "coverages" : {
            "items" : {
              "$ref" : "#/components/schemas/CoverageRequest"
            },
            "type" : "array"
          },
          "customerId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "endDate" : {
            "format" : "date",
            "type" : "string"
          },
          "premium" : {
            "exclusiveMinimum" : false,
            "minimum" : 0.01,
            "type" : "number"
          },
          "productType" : {
            "enum" : [ "MOTOR", "HOME", "HEALTH" ],
            "type" : "string"
          },
          "startDate" : {
            "format" : "date",
            "type" : "string"
          }
        },
        "required" : [ "coverages", "customerId", "endDate", "premium", "productType", "startDate" ],
        "type" : "object"
      },
      "CustomerResponse" : {
        "properties" : {
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "dateOfBirth" : {
            "format" : "date",
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          },
          "firstName" : {
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "lastName" : {
            "type" : "string"
          },
          "phone" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "FieldViolation" : {
        "properties" : {
          "field" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          }
