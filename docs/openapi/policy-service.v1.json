        "properties" : {
          "coverages" : {
            "items" : {
              "$ref" : "#/components/schemas/CoverageResponse"
            },
            "type" : "array"
          },
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "customerId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "endDate" : {
            "format" : "date",
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "policyNumber" : {
            "type" : "string"
          },
          "premium" : {
            "type" : "number"
          },
          "productType" : {
            "enum" : [ "MOTOR", "HOME", "HEALTH" ],
            "type" : "string"
          },
          "startDate" : {
            "format" : "date",
            "type" : "string"
          },
          "status" : {
            "enum" : [ "ACTIVE", "CANCELLED" ],
            "type" : "string"
          },
          "version" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "type" : "object"
      }
